<?xml version="1.0" encoding="UTF-8"?>
<!--
  Tomcat Context 描述符 — 稿件管理系统
  部署位置：$CATALINA_HOME/conf/Catalina/localhost/gaojiaoguanli.xml
  功能：将外部上传目录映射为 WAR 内的 /upload 路径，使 UEditor 静态图片 URL 正常工作
-->
<Context docBase="/opt/tomcat/webapps/gaojiaoguanli">

    <Resources>
        <!--
          DirResourceSet：将 NFS 共享上传目录挂载到 /upload 路径
          - base：外部目录绝对路径（所有 Tomcat 节点通过 NFS 共享）
          - webAppMount：WAR 内的虚拟路径，对应前端 UEditor 图片 URL
          - className：Tomcat 9.x 使用 DirResourceSet
        -->
        <PostResources className="org.apache.catalina.webresources.DirResourceSet"
                       base="/data/uploads/gaojiaoguanli"
                       webAppMount="/upload" />
    </Resources>

    <!-- 可选：JNDI 数据源（如需要替代 Spring 配置的 Druid 池） -->
    <!--
    <Resource name="jdbc/gaojiaoguanli"
              auth="Container"
              type="javax.sql.DataSource"
              driverClassName="com.mysql.jdbc.Driver"
              url="jdbc:mysql://prod-db:3306/gaojiaoguanli"
              username="gaojiao_prod"
              password="CHANGE_ME"
              maxTotal="20"
              maxIdle="10"
              maxWaitMillis="60000"/>
    -->
</Context>
